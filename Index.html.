<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ChemSafe School</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#f1f5f9;
  color:#172554
}
header{
  background:#12345a;
  color:white;
  padding:25px;
  text-align:center
}
main{max-width:1000px;margin:25px auto;padding:15px}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:15px
}
.card{
  background:white;
  padding:20px;
  border-radius:12px;
  box-shadow:0 3px 12px #0001
}
button{
  background:#087ea4;
  color:white;
  border:0;
  padding:12px;
  border-radius:8px;
  cursor:pointer
}
.badge{font-weight:bold;color:#087e59}
footer{text-align:center;padding:25px;color:#64748b}
</style>
</head>

<body>
<header>
  <h1>🧪 ChemSafe School</h1>
  <p>Hệ thống quản lý tủ hóa chất thông minh</p>
</header>

<main>
  <h2>📊 Tổng quan</h2>

  <div class="grid">
    <section class="card">
      <h3>Tổng số chai</h3>
      <p>03 chai mẫu</p>
    </section>

    <section class="card">
      <h3>Trạng thái tủ</h3>
      <p id="status" class="badge">Đang khóa 🔒</p>
      <button onclick="toggleLock()">Mô phỏng khóa/mở</button>
    </section>

    <section class="card">
      <h3>Cảnh báo an ninh</h3>
      <p id="alert">Không có cảnh báo</p>
    </section>
  </div>

  <h2>🧴 Danh sách chai</h2>

  <div class="grid">
    <section class="card">
      <h3>CHEM-001</h3>
      <p>Chai mẫu A</p>
      <p>Vị trí: A01</p>
      <p>Khối lượng: 500 g</p>
      <p>Trạng thái: Đã khóa</p>
    </section>

    <section class="card">
      <h3>CHEM-002</h3>
      <p>Chai mẫu B</p>
      <p>Vị trí: A02</p>
      <p>Khối lượng: 450 g</p>
      <p>Trạng thái: Đã khóa</p>
    </section>

    <section class="card">
      <h3>CHEM-003</h3>
      <p>Chai mẫu C</p>
      <p>Vị trí: A03</p>
      <p>Khối lượng: 300 g</p>
      <p>Trạng thái: Đã khóa</p>
    </section>
  </div>
</main>

<footer>
  ChemSafe School | Mô hình nghiên cứu khoa học THPT
</footer>

<script>
let locked=true;

function toggleLock(){
  locked=!locked;

  document.getElementById("status").textContent=
    locked?"Đang khóa 🔒":"Đang mở 🔓";

  document.getElementById("alert").textContent=
    locked?"Không có cảnh báo":"Đang ở chế độ mô phỏng";
}
</script>
</body>
</html>
